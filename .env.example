AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=

# API CRM - clé secrète serveur uniquement
ACREMAP_CRM_API_KEY=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
