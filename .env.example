# AcreMap — Neon development branch
VITE_NEON_AUTH_URL_DEV=https://YOUR_NEON_AUTH_HOST/neondb/auth
VITE_NEON_DATA_API_URL_DEV=https://YOUR_NEON_DATA_API_HOST/neondb/rest/v1
NEON_DATABASE_URL_DEV=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL_DEV=https://YOUR_NEON_AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL_DEV=https://YOUR_NEON_AUTH_HOST/neondb/auth/.well-known/jwks.json
NEON_PROJECT_ID_DEV=
NEON_BRANCH_ID_DEV=

# Neon Object Storage — server only, never expose through VITE_ variables
AWS_ACCESS_KEY_ID_DEV=
AWS_SECRET_ACCESS_KEY_DEV=
AWS_ENDPOINT_URL_S3_DEV=
AWS_REGION_DEV=us-east-2

# CRM integration — server only; development remains disabled until validation
ACREMAP_CRM_API_KEY_DEV=
CRM_WEBHOOK_URL_DEV=https://YOUR_CRM_PROJECT.supabase.co/functions/v1/acremap-webhook
CRM_WEBHOOK_SECRET_DEV=
CRM_INTEGRATION_ENABLED_DEV=false

# Production values are intentionally separate and must only be set after the Neon cutover:
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
NEON_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
ACREMAP_CRM_API_KEY=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_INTEGRATION_ENABLED=false

# Optional map provider
GOOGLE_MAPS_API_KEY=
